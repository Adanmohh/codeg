  {
    "name": "desk_save_reply",
    "description": "Scoped Desk save reply; never approves or executes an external action.",
    "inputSchema": {
      "type": "object",
      "required": [
        "inboxId",
        "conversationId",
        "expectedRevision",
        "reply"
      ],
      "properties": {
        "inboxId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "conversationId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "reply": {
          "type": "object",
          "required": [
            "inboxId",
            "conversationId",
            "from",
            "to",
            "cc",
            "bcc",
            "subject",
            "text",
            "inReplyTo",
            "references"
          ],
          "properties": {
            "inboxId": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "conversationId": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "from": {
              "type": "string",
              "maxLength": 998,
              "pattern": "^[^\\r\\n\\u0000]*$"
            },
            "to": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 998,
                "pattern": "^[^\\r\\n\\u0000]*$"
              },
              "maxItems": 50
            },
            "cc": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 998,
                "pattern": "^[^\\r\\n\\u0000]*$"
              },
              "maxItems": 50
            },
            "bcc": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 998,
                "pattern": "^[^\\r\\n\\u0000]*$"
              },
              "maxItems": 50
            },
            "subject": {
              "type": "string",
              "maxLength": 998,
              "pattern": "^[^\\r\\n\\u0000]*$"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000
            },
            "inReplyTo": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 998,
                  "pattern": "^[^\\r\\n\\u0000]*$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "references": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 998,
                "pattern": "^[^\\r\\n\\u0000]*$"
              },
              "maxItems": 100
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "desk_propose_reply",
    "description": "Scoped Desk propose reply; never approves or executes an external action.",
    "inputSchema": {
      "type": "object",
      "required": [
        "draftId",
        "expectedRevision"
      ],
      "properties": {
        "draftId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "additionalProperties": false
    }
  }
