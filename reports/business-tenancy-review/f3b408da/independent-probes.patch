+const TENANCY: &str = "m20260908_000012_business_tenancy";
+
+async fn prefix(conn: &DatabaseConnection) {
+    let count = Migrator::migrations()
+        .iter()
+        .position(|m| m.name() == TENANCY)
+        .unwrap();
+    Migrator::up(conn, Some(count.try_into().unwrap()))
+        .await
+        .unwrap();
+}
