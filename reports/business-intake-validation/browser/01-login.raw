      page.__workerGuard.responses.push({
        path: url.slice("http://127.0.0.1:4354".length),
        status: response.status(),
      })
  })
  try {
    await page.getByLabel("Workspace address", { exact: true }).fill(
      "http://127.0.0.1:4354"
