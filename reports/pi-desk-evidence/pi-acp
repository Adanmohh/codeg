#!/bin/sh
# Availability-only browser fixture. No ACP server or model implementation.
# Lets the real connect path reach Pi Desk's installed-client/model preflight.
if [ "$#" -eq 1 ] && [ "$1" = "--version" ]; then
  printf '%s\n' '0.0.33'
  exit 0
fi
printf '%s\n' 'Unexpected ACP launch: browser fixture must stop at model preflight' >&2
exit 99
